+/* The views of a process are also kept in a tree by base address: with
+ * the list alone every map searched all of them for an overlap, and every
+ * unmap for the view; a process with tens of thousands of views (a console
+ * title's physical page views, mapped and unmapped as it streams) spent a
+ * millisecond in each, while its client held the virtual memory lock. Views
+ * never overlap (every add is checked first), so the view with the greatest
+ * base at or below an address is the only one that can hold it. */
+static int view_tree_compare( const void *key, const struct rb_entry *entry )
+{
+    client_ptr_t base = *(const client_ptr_t *)key;
+    const struct memory_view *view = RB_ENTRY_VALUE( entry, const struct memory_view, tree_entry );
+
+    if (base < view->base) return -1;
+    if (base > view->base) return 1;
+    return 0;
+}
+
+void init_process_view_tree( struct process *process )
+{
+    rb_init( &process->view_tree, view_tree_compare );
+    process->view_tree_bad = 0;
+}
+
+/* the view with the greatest base not above addr, from the tree */
+static struct memory_view *view_at_or_below( struct process *process, client_ptr_t addr )
+{
+    struct rb_entry *entry = process->view_tree.root;
+    struct memory_view *best = NULL;
+
+    while (entry)
+    {
+        struct memory_view *view = RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+        if (view->base <= addr)
+        {
+            best = view;
+            entry = entry->right;
+        }
+        else entry = entry->left;
+    }
+    return best;
+}
+
 /* find a memory view from its base address */
